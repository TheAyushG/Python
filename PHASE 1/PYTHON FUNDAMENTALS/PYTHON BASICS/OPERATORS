num1 = 10
num2 = 3

# Arithmetic Operators

print("num1 + num2 is", num1 + num2)
print("num1 - num2 is", num1 - num2)
print("num1 * num2 is", num1 * num2)
print("num1 / num2 is", num1 / num2)
print("num1 // num2 is", num1 // num2)
print("num1 ** num2 is", num1 ** num2)
print("num1 % num2 is", num1 % num2)

// OUTPUT
num1 + num2 is 13
num1 - num2 is 7
num1 * num2 is 30
num1 / num2 is 3.3333333333333335
num1 // num2 is 3
num1 ** num2 is 1000
num1 % num2 is 1

